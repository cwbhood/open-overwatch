# local / generated
.claude/
__pycache__/
*.pyc
*.log
dist/
# big or regenerable brand files (rebuild commands in brand/README.md)
brand/video/
brand/tools/_*/
brand/tools/_*.log
brand/models/previews/
brand/hero/*.png
brand/lander/hero-*.png
# NASA source rasters (regenerate textures with brand/tools/make_earth_fx.py)
brand/source/*.tif
brand/source/*.exr
brand/source/planets/
# JPL SBDB raw query cache (rebuild data/solar with brand/tools/make_small_bodies.py)
brand/source/sbdb/
# downloaded catalogues / ephemerides (rebuild with brand/tools/make_stars.py, make_spacecraft.py)
brand/source/hyg/
brand/source/horizons/
# moon maps and the 2MRS galaxy catalogue (rebuild with brand/tools/make_moon_textures.py, make_galaxies.py)
brand/source/moons/
brand/source/2mrs/

# perf.mjs measurements (summaries go in docs/PERFORMANCE.md)
brand/perf/
